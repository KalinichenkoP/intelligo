# Application
PORT=3000
NODE_ENV=development

# DocketAlarm credentials (never commit real values)
DOCKET_ALARM_USERNAME=your-username@example.com
DOCKET_ALARM_PASSWORD=your-password
DOCKET_ALARM_BASE_URL=https://www.docketalarm.com/api/v1
DOCKET_ALARM_CLIENT_MATTER=intelligo-legal-results

# Redis
REDIS_URL=redis://localhost:6379

# BullMQ queue name (override in tests to isolate from yarn start:dev)
SEARCH_QUEUE_NAME=docket-alarm-search

# Outbound concurrency / rate limiting (BullMQ)
# Per-worker-instance concurrency
DOCKET_ALARM_MAX_CONCURRENCY=5
# Fleet-wide rate cap: max job starts per duration window
DOCKET_ALARM_RATE_LIMIT_MAX=5
DOCKET_ALARM_RATE_LIMIT_DURATION_MS=1000

# Job retry / backoff
DOCKET_ALARM_RETRY_ATTEMPTS=3
DOCKET_ALARM_RETRY_BACKOFF_MS=1000

# Result cache / job retention (seconds)
RESULT_CACHE_TTL_SECONDS=30
FAILED_JOB_RETENTION_SECONDS=10

# Max time an HTTP request awaits waitUntilFinished (ms)
JOB_WAIT_TIMEOUT_MS=20000

# Alias fan-out controls
ALIAS_MIN_CONFIDENCE=0.3
MAX_ALIAS_NAMES=5

# Public API throttling
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
